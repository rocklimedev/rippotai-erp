# Storage configuration example only. Merge into your existing backend .env;
# this is not a replacement for database/auth/other application configuration.
CDN_HOST=
CDN_PORT=22
CDN_USERNAME=
CDN_PASSWORD=
CDN_UPLOAD_PATH=/tmp/inos-cdn
CDN_BASE_URL=http://localhost:5000/cdn
PRIVATE_FILE_PATH=/tmp/inos-private
# Remote CDN must proxy private-* requests to the API signed-file endpoint.
CDN_PRIVATE_PROXY_ENABLED=false
FILE_ACCESS_SECRET=

# NAS is opt-in. Existing CDN files remain on CDN.
NAS_ENABLED=false
NAS_HOST=
NAS_PORT=22
NAS_USERNAME=
NAS_PASSWORD=
# Absolute SFTP-visible directory on Synology, not a Windows/SMB path or URL.
# Confirm the path with the dedicated service account's SFTP session.
NAS_UPLOAD_PATH=/volume1/inos-erp
NAS_MIN_FILE_SIZE_MB=50
# Trusted NAS SSH host key SHA256 digest as 64 hex characters (not base64).
NAS_HOST_KEY_SHA256=

# Accept NAS-bound uploads on the CDN while NAS is unreachable.
# This directory MUST be private and outside CDN_UPLOAD_PATH / public webroot.
# Remote SFTP path on the CDN host; local filesystem path when CDN_HOST is empty.
NAS_STAGING_ENABLED=false
# Example remote directory: /home/account/inos-nas-staging
NAS_CDN_STAGING_PATH=
# External ingress can stage every NAS-bound file without first contacting NAS.
NAS_STAGE_ALL_UPLOADS=false
# Enable on a backend instance with access to BOTH CDN and NAS (LAN/VPN).
NAS_TRANSFER_WORKER_ENABLED=false
NAS_TRANSFER_INTERVAL_MINUTES=5
NAS_STAGING_MIN_AGE_MINUTES=5

# Required client-link encryption (see documentation/client-link-encryption.md).
# Generate an independent base64-encoded 32-byte random secret; no fallback.
CLIENT_LINK_KEY_ID=
CLIENT_LINK_ENCRYPTION_SECRET=
# Optional read-only keys for rotation: {"old-id":"base64-secret"}
CLIENT_LINK_PREVIOUS_KEYS={}
# Optional explicit historical raw AES key, base64; remove after verified migration.
CLIENT_LINK_LEGACY_KEY=
